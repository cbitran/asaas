# Voz do assistente (ElevenLabs). Copie este arquivo para .env e preencha.
# O .env fica só nesta máquina: a chave nunca é enviada ao navegador.

# Chave de API da sua conta ElevenLabs. Pode ficar vazia se você já tem a chave em
# ~/.elevenlabs.env (linha ELEVENLABS_API_KEY=...) ou na variável de ambiente ELEVENLABS_API_KEY:
# o servidor lê desses lugares automaticamente.
ELEVENLABS_API_KEY=

# ID da voz escolhida na sua biblioteca da ElevenLabs (use uma voz em português do Brasil)
ELEVENLABS_VOICE_ID=

# Opcionais
# Modelo: eleven_multilingual_v2 (padrão, estável e natural), eleven_flash_v2_5 (mais rápido)
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Estabilidade menor = fala mais expressiva; maior = mais uniforme
# ELEVENLABS_STABILITY=0.45
# ELEVENLABS_SIMILARITY=0.75
# ELEVENLABS_STYLE=0
# ELEVENLABS_SPEED=1
